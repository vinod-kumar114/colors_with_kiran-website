<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="main">

  <!-- ============================================================ HERO -->
  <section class="hero">
    <div class="hero__media">
      <% if (s['home.hero_image']) { %>
        <img src="<%= s['home.hero_image'] %>" alt="Intricate bridal mehndi design by Colors with Kiran in Qasimabad, Hyderabad" fetchpriority="high" width="1600" height="900">
      <% } %>
    </div>
    <div class="wrap hero__inner">
      <span class="kicker"><%= s['home.hero_kicker'] %></span>
      <h1><%- s['home.hero_title'] %></h1>
      <p class="hero__text"><%= s['home.hero_text'] %></p>
      <div class="btn-row">
        <a class="btn btn--gold" href="/portfolio">View My Designs <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <a class="btn btn--light" href="/contact">Contact / Book Now</a>
      </div>
      <div class="hero__badges">
        <span><svg aria-hidden="true"><use href="#i-check"/></svg> 100% natural henna</span>
        <span><svg aria-hidden="true"><use href="#i-pin"/></svg> <%= s['contact.area'] %>, <%= s['contact.city'] %></span>
        <span><svg aria-hidden="true"><use href="#i-star"/></svg> <%= s['about.experience'] %> experience</span>
      </div>
    </div>
  </section>

  <!-- ======================================================== FEATURED -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="kicker">Featured Work</span>
        <h2>Designs worth showing off</h2>
        <div class="flourish"><svg aria-hidden="true"><use href="#i-sparkle"/></svg></div>
        <p class="lede">A handful of favourites from recent brides, Eid sittings and mehndi nights.</p>
      </div>

      <% if (featured.length) { %>
        <div class="grid grid--auto">
          <% featured.forEach((d, i) => { %>
            <div class="reveal" style="transition-delay:<%= Math.min(i * 70, 350) %>ms">
              <%- include('partials/card', { d, eager: i < 3 }) %>
            </div>
          <% }) %>
        </div>
        <div class="btn-row btn-row--center mt-2">
          <a class="btn btn--ghost" href="/portfolio">See the full portfolio <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      <% } else { %>
        <div class="empty"><svg aria-hidden="true"><use href="#i-image"/></svg><p>No designs yet — add your first one from the admin dashboard.</p></div>
      <% } %>
    </div>
  </section>

  <!-- ======================================================= CATEGORIES -->
  <% if (popularCategories.length) { %>
  <section class="section section--cream">
    <div class="wrap">
      <div class="head reveal">
        <span class="kicker">Browse by Style</span>
        <h2>Popular categories</h2>
        <div class="flourish"><svg aria-hidden="true"><use href="#i-leaf"/></svg></div>
      </div>
      <div class="grid grid--auto">
        <% popularCategories.forEach(c => { %>
          <a class="cat-card reveal <%= c.cover ? '' : 'cat-card--empty' %>" href="/portfolio?category=<%= c.slug %>">
            <% if (c.cover) { %>
              <img src="<%= c.cover.thumb_url %>" alt="<%= c.name %> designs by Colors with Kiran, Qasimabad Hyderabad" loading="lazy" width="700" height="875">
            <% } %>
            <div class="cat-card__veil"></div>
            <div class="cat-card__body">
              <div class="cat-card__emoji"><%= c.emoji %></div>
              <div class="cat-card__name"><%= c.name %></div>
              <div class="cat-card__n"><%= c.design_count %> design<%= c.design_count === 1 ? '' : 's' %></div>
            </div>
          </a>
        <% }) %>
      </div>
      <div class="btn-row btn-row--center mt-2">
        <a class="btn btn--ghost" href="/categories">All categories <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============================================================ ABOUT -->
  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <div class="portrait">
          <% if (s['about.photo']) { %>
            <img src="<%= s['about.photo'] %>" alt="Kiran, professional mehndi artist in Qasimabad Hyderabad, applying henna" loading="lazy" width="800" height="1000">
          <% } %>
          <div class="portrait__badge">
            <strong><%= s['about.experience'] %></strong>
            <span>Experience</span>
          </div>
        </div>
      </div>
      <div class="reveal">
        <span class="kicker">About the Artist</span>
        <h2 style="margin:.6rem 0 .3rem"><%= s['home.intro_title'] %></h2>
        <p class="script" style="color:var(--henna);font-size:1.2rem;margin-bottom:1rem;"><%= s['about.subheading'] %></p>
        <div class="prose"><p><%= s['home.intro_text'] %></p></div>
        <ul class="tick-list">
          <% asList(s['about.specialties']).slice(0, 4).forEach(item => { %>
            <li><svg aria-hidden="true"><use href="#i-check"/></svg><span><%= item %></span></li>
          <% }) %>
        </ul>
        <div class="btn-row" style="margin-top:1.8rem">
          <a class="btn btn--primary" href="/about">Read my story</a>
          <a class="btn btn--ghost" href="/pricing">See pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== PRICING -->
  <% if (pricing.length) { %>
  <section class="section section--cream">
    <div class="wrap" style="max-width:820px">
      <div class="head reveal">
        <span class="kicker">Transparent Rates</span>
        <h2>Starting prices</h2>
        <div class="flourish"><svg aria-hidden="true"><use href="#i-sparkle"/></svg></div>
      </div>
      <div class="reveal">
        <table class="price-table">
          <thead><tr><th scope="col">Service</th><th scope="col">Starting Price</th></tr></thead>
          <tbody>
            <% pricing.forEach(p => { %>
              <tr>
                <td class="svc"><%= p.service %><% if (p.note) { %><span class="note"><%= p.note %></span><% } %></td>
                <td class="amt"><%= p.price_text %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="btn-row btn-row--center mt-2">
          <a class="btn btn--ghost" href="/pricing">Full price list <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ===================================================== TESTIMONIALS -->
  <% if (testimonials.length) { %>
  <section class="section section--leaf">
    <div class="wrap">
      <div class="head reveal">
        <span class="kicker">Kind Words</span>
        <h2>What my clients say</h2>
        <div class="flourish"><svg aria-hidden="true"><use href="#i-leaf"/></svg></div>
      </div>
      <div class="quote-grid">
        <% testimonials.forEach(t => { %>
          <figure class="quote reveal">
            <div class="stars" aria-label="<%= t.rating %> out of 5 stars">
              <% for (let i = 0; i < t.rating; i++) { %><svg aria-hidden="true"><use href="#i-star"/></svg><% } %>
            </div>
            <blockquote class="quote__text"><%= t.review %></blockquote>
            <figcaption class="quote__who">
              <% if (t.photo) { %>
                <img class="avatar" src="/uploads/thumb/<%= t.photo %>" alt="<%= t.name %>" loading="lazy" width="42" height="42">
              <% } else { %>
                <span class="avatar" aria-hidden="true"><%= t.name.trim().charAt(0).toUpperCase() %></span>
              <% } %>
              <span>
                <span class="quote__name"><%= t.name %></span>
                <% if (t.event_type) { %><span class="quote__event"><%= t.event_type %></span><% } %>
              </span>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============================================================== CTA -->
  <section class="section cta-band">
    <div class="wrap">
      <span class="kicker" style="color:var(--gold-soft)">Book Your Date</span>
      <h2 style="margin-top:.6rem">Book Your Mehndi Appointment</h2>
      <p>Weekend and event dates fill up quickly, especially around Eid and wedding season. Send me a message and I will confirm availability the same day.</p>
      <div class="btn-row btn-row--center" style="margin-top:1.9rem">
        <a class="btn btn--wa" href="<%= wa() %>" target="_blank" rel="noopener">
          <svg aria-hidden="true"><use href="#i-wa"/></svg> Message on WhatsApp
        </a>
        <a class="btn btn--light" href="/contact">Fill the booking form</a>
      </div>
    </div>
  </section>

</main>
<%- include('partials/footer') %>
</body>
</html>
