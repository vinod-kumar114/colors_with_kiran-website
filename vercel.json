{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "functions": {
    "api/**/*.js": {
      "includeFiles": "views/**"
    },
    "api/**/*.mjs": {
      "includeFiles": "views/**"
    },
    "src/**/*.js": {
      "includeFiles": "views/**"
    },
    "src/**/*.mjs": {
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!_vercel).*)",
      "destination": "/api/index"
    }
  ]
}
