# ============================================================================
#  Colors with Kiran — environment configuration
#  Copy this file to ".env" and fill in your own values.
#  On Vercel you do NOT upload this file — you paste these into
#  Vercel → Project → Settings → Environment Variables.
# ============================================================================


# ── 1. DATABASE  (required) ─────────────────────────────────────────────────
#
# LOCAL (your own computer) — leave this out entirely. It defaults to a file
# at ./data/colorswithkiran.db and needs no accounts.
#
# CLOUD (Vercel) — create a free database at https://turso.tech and paste its
# URL and token here. Vercel has no permanent disk, so a file database would
# lose every photo and booking on each deploy.
#
# DATABASE_URL=libsql://your-db-name-yourusername.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOiJF...


# ── 2. PHOTO STORAGE  (required on Vercel) ──────────────────────────────────
#
# LOCAL — leave these out. Photos are saved to ./public/uploads.
#
# CLOUD — create a free account at https://cloudinary.com and copy the three
# values from your dashboard. Without these, uploading a photo on Vercel will
# fail, because serverless functions cannot write files.
#
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz
#
# Optional — the folder your photos are filed under inside Cloudinary.
# CLOUDINARY_FOLDER=colors-with-kiran
#
# Force a driver instead of auto-detecting ("local" or "cloudinary").
# STORAGE_DRIVER=cloudinary


# ── 3. SECURITY  (required in production) ───────────────────────────────────
#
# Signs the admin session cookie. MUST be set on Vercel: without a stable
# value, every serverless instance signs differently and login never sticks.
# Generate one with:  openssl rand -hex 32
#
# COOKIE_SECRET=


# ── 4. ADMIN ACCOUNT  (first run only) ──────────────────────────────────────
#
# Used only when creating the very first admin account. Afterwards, change the
# password from Settings inside the dashboard.
#
ADMIN_USER=kiran
ADMIN_PASS=mehndi123


# ── 5. SITE  (recommended in production) ────────────────────────────────────
#
# Your public address, no trailing slash. Used for canonical URLs, sitemap.xml
# and social share previews.
# SITE_URL=https://colorswithkiran.com

# Set to "production" when deploying. Vercel sets this for you automatically.
# NODE_ENV=production

# Port for local use only. Vercel ignores it.
PORT=3000


# ── 6. OPTIONAL ─────────────────────────────────────────────────────────────

# CSP frame-ancestors. Keep 'self' in production so nobody can embed your
# admin panel inside their own page.
# FRAME_ANCESTORS='self'

# Largest photo an admin may upload, in MB.
# Vercel hard-caps a request body at 4.5 MB, so the default there is 4.
# Self-hosted installs default to 12.
# MAX_UPLOAD_MB=4

# Extra image hosts to allow in the Content-Security-Policy, space separated.
# EXTRA_IMG_SRC=https://images.example.com

# Self-hosted only: move the database and photos onto a mounted disk.
# Ignored when DATABASE_URL / Cloudinary are set.
# DATA_DIR=/app/storage/data
# UPLOADS_DIR=/app/storage/uploads

# Skip demo-content seeding on boot (useful once you have real designs).
# SKIP_SEED=1
